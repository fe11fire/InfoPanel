{
    "server_ip": "127.0.0.1",
    "server_port": 8084,
    "path_video": "..\\content\\video",
    "path_present": "..\\content\\present",
    "path_birthday": "..\\content\\birthday",
    "file_birthday": "birthday.txt",
    "path_holiday": "..\\content\\holiday",
    "file_holiday": "holiday.txt",
    "path_text": "..\\content\\text",
    "path_images": "..\\content\\imgs",

    "request_timeout": 5000,
    "error_ttl": 300000,
    "show_errors": true,
    "matrix_enable": false,
    "matrix_duration": 2000,
    "start_timeOut": 3000,
    "side_changing": true,
    "side_changing_interval": 15000,
    "config_update_interval": 10000,
    "jobs_restart_timeOut": 10000,
    "header_text": "COMPANY NAME",
    "video_stall_timeout": 15000,
    "content_video_volume": 0,
    "content_present_interval": 10000,
    "content_img_interval": 10000,
    "content_text_interval": 10000,
    "content_birthdays_interval": 10000,
    "content_birthdays_next_count": 5,
    "content_birthdays_prev_count": 2,
    "content_birthdays_max_font_size": 24,
    "line_next_birthdays_count": 5,

    "with_present": true,
    "with_imgs": true,
    "with_text": true,
    "with_birthdays": true,
    "with_video": true,
    "with_birthday": true,
    "with_next_birthdays": true,

    "content_extensions_ignore": {
        "common": [],
        "video": [],
        "text": []
    },

    "info_line_changing_interval": 10000,
    "info_line_height": "80px",
    "info_line_background_color": "linear-gradient(#08184f, #9198e5)",

    "cursor": "default",
    "background_color": "#08184f",
    "padding_top": "20px",
    "padding_bottom": "20px",
    "padding_left": "10px",
    "padding_right": "50px",
    "header_height": "80px",
    "header_font_size": "26px",
    "header_color": "#fff",
    "logo_width": "100px",
    "calendar_color": "#fff",
    "calendar_day_font_size": "105px",
    "calendar_text_font_size": "35px",
    "clock_color": "#fff",
    "clock_size": "50px",
    "birthday_name_font_size": "30px",
    "birthday_text_font_size": "24px",
    "birthday_color": "#fff"
}
